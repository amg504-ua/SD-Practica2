#Plantilla de Configuración del Proyecto
#Documenta qué variables necesita cada módulo y muestra valores de ejemplo
#Se sube a Github

# Kafka de Railway: acceso público
KAFKA_HOST=tokaido.proxy.rlwy.net
KAFKA_PORT=40908

# WM_Central: acceso TCP público de Railway
CENTRAL_HOST=acela.proxy.rlwy.net
CENTRAL_PORT=43731

# Monitor: puerto interno del contenedor
MONITOR_SOCKET_PORT=5001

# Engine: conexión al Monitor en la red Docker
MONITOR_HOST=wm-monitor
MONITOR_PORT=5001